{
  "name": "@statewalker/workspace-vcs.core",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "description": "GitNature — version control as an opt-in nature of a workbench project: init/add/commit/log/status plus HTTP remotes over a real, native-compatible .git.",
  "homepage": "https://github.com/statewalker/statewalker-workbench",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/statewalker/statewalker-workbench.git"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CONTEXT.md"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "build": "tsdown"
  },
  "dependencies": {
    "@statewalker/workspace.core": "workspace:^",
    "@statewalker/vcs-commands": "catalog:",
    "@statewalker/vcs-core": "catalog:",
    "@statewalker/vcs-store-files": "catalog:",
    "@statewalker/vcs-transport": "catalog:",
    "@statewalker/vcs-transport-adapters": "catalog:",
    "@statewalker/vcs-working-tree": "catalog:",
    "@statewalker/vcs-workspace": "catalog:",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-composite": "catalog:"
  },
  "devDependencies": {
    "@statewalker/vcs-utils-node": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
