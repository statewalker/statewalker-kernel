{
  "name": "@statewalker/backbone.browser",
  "version": "0.4.2",
  "private": false,
  "type": "module",
  "description": "Backbone web runtime: fragment loader + browser-side activation for the backbone platform.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-kernel/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-kernel/tree/main/packages/backbone.browser#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-kernel.git",
    "directory": "packages/backbone.browser"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@statewalker/backbone.core": "workspace:^",
    "sucrase": "catalog:"
  },
  "devDependencies": {
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
