{
  "name": "@statewalker/explorer.core",
  "version": "0.5.2",
  "private": false,
  "type": "module",
  "description": "File-explorer logic fragment: navigation, search controller, tree-state, browser orchestration intents.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-kernel/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-kernel/tree/main/packages/explorer.core#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-kernel.git",
    "directory": "packages/explorer.core"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fragment": {
      "source": "./src/fragment.ts",
      "types": "./dist/fragment.d.ts",
      "import": "./dist/fragment.js",
      "default": "./dist/fragment.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "build": "tsdown"
  },
  "dependencies": {
    "@json-render/core": "catalog:",
    "@statewalker/shell.core": "workspace:^",
    "@statewalker/mime.core": "workspace:^",
    "@statewalker/shared-baseclass": "catalog:",
    "@statewalker/shared-commands": "catalog:",
    "@statewalker/shared-registry": "catalog:",
    "@statewalker/shared-slots": "catalog:",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/workspace.core": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@statewalker/webrun-files-mem": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
