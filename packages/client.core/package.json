{
  "name": "@statewalker/client.core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The platform's client API: what a fragment's client half imports (by bare specifier, shared through the shell's import map) to reach the platform, starting with the command bus.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-kernel/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-kernel/tree/main/packages/client.core#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-kernel.git",
    "directory": "packages/client.core"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
