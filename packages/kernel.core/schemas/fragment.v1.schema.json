{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fragment manifest (fragment.jsonc), version 1",
  "type": "object",
  "required": ["$schema", "id", "version", "engines", "aspects"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "The URL or path of this schema; its file name carries the version.",
      "type": "string",
      "pattern": "(^|/)fragment\\.v1\\.schema\\.json$"
    },
    "id": {
      "description": "Reverse-domain id, never changed (org.example.fragment-notes); system.* is reserved for the platform's core fragments.",
      "type": "string",
      "minLength": 1
    },
    "version": {
      "description": "The fragment's version (semver).",
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "requires": {
      "description": "Required fragments: fragment id to a semver range.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "engines": {
      "type": "object",
      "required": ["platform"],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "description": "The platform versions this fragment runs on (a semver range).",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bindings": {
      "description": "Bindings the host must offer.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "aspects": {
      "description": "The aspects present. The platform fixes them: server (wrangler.jsonc), client and agent.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": {
          "$ref": "#/$defs/aspect"
        },
        "client": {
          "$ref": "#/$defs/aspect"
        },
        "agent": {
          "$ref": "#/$defs/aspect"
        }
      }
    }
  },
  "$defs": {
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "description": "The aspect's folder, when not the default (server/, client/, agent/): a path relative to the archive, never a URL, an absolute path or a way out (`..`).",
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(\\./)?[A-Za-z0-9_@+-][A-Za-z0-9_.@+-]*(/[A-Za-z0-9_@+-][A-Za-z0-9_.@+-]*)*/?$"
        }
      }
    }
  }
}
