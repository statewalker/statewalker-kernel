{
  "name": "@statewalker/kernel.core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The platform kernel: fragment manifests (fragment.jsonc) validated against a versioned JSON Schema, and the fragment lifecycle (installed, enabled, resolved, active per aspect) as membership in keyed slots.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-kernel/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-kernel/tree/main/packages/kernel.core#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-kernel.git",
    "directory": "packages/kernel.core"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas/fragment.v1.schema.json": "./schemas/fragment.v1.schema.json"
  },
  "files": [
    "dist",
    "src",
    "schemas"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@cfworker/json-schema": "catalog:",
    "@statewalker/shared-slots": "catalog:",
    "jsonc-parser": "catalog:",
    "semver": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
