{
  "name": "@statewalker/fragment-build.node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node side of fragment authoring: loads a fragment.config.ts, writes the generated files beside it, packs the built folder into a content-hashed archive, and the fragment-build command.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-kernel/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-kernel/tree/main/packages/fragment-build.node#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-kernel.git",
    "directory": "packages/fragment-build.node"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "fragment-build": "./bin/fragment-build.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@statewalker/fragment-build.core": "workspace:^",
    "@statewalker/kernel.core": "workspace:^",
    "semver": "catalog:",
    "tsx": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:peers"
  },
  "devDependencies": {
    "@statewalker/system.commands": "workspace:^",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "zod": "catalog:"
  },
  "sideEffects": false
}
