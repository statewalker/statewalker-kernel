{
  "name": "@statewalker/platform.browser",
  "version": "0.5.2",
  "private": false,
  "type": "module",
  "description": "Browser implementation of the @statewalker/platform.core commands — pickers, downloads, clipboard, preferences, URL-hash binding.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-kernel/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-kernel/tree/main/packages/platform.browser#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-kernel.git",
    "directory": "packages/platform.browser"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@statewalker/platform.core": "workspace:^",
    "@statewalker/shared-commands": "catalog:",
    "@statewalker/shared-logger": "catalog:",
    "@statewalker/shared-logger-pino": "catalog:",
    "@statewalker/shared-registry": "catalog:",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-browser": "catalog:",
    "@statewalker/workspace.core": "workspace:^"
  },
  "devDependencies": {
    "@statewalker/webrun-files-mem": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
