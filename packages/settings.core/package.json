{
  "name": "@statewalker/settings.core",
  "version": "0.5.1",
  "private": false,
  "type": "module",
  "description": "Settings logic fragment.",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fragment": {
      "source": "./src/fragment.ts",
      "types": "./dist/fragment.d.ts",
      "import": "./dist/fragment.js",
      "default": "./dist/fragment.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "build": "tsdown"
  },
  "dependencies": {
    "@statewalker/shared-baseclass": "catalog:",
    "@statewalker/shared-commands": "catalog:",
    "@statewalker/shared-registry": "catalog:",
    "@statewalker/shared-slots": "catalog:",
    "@statewalker/workspace.core": "workspace:^"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
