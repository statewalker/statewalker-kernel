{
  "name": "@statewalker/system.fragments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The system.fragments core fragment: the fragment manager. What an archive asks for before the user consents (its consent summary), installs with its proposed requirements all or nothing, the installed fragments' states, enable, disable, retry and remove with or without data.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-kernel/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-kernel/tree/main/fragments/system.fragments#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-kernel.git",
    "directory": "fragments/system.fragments"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "source": "./client/index.ts",
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./client.css": "./dist/client.css"
  },
  "files": [
    "dist",
    "src",
    "client",
    "fragment.jsonc",
    "fragment.client.jsonc"
  ],
  "scripts": {
    "build": "tsdown && tailwindcss -i client/styles.css -o dist/client.css --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@statewalker/kernel.core": "workspace:^",
    "semver": "catalog:",
    "@statewalker/ui.view.shadcn": "workspace:^"
  },
  "devDependencies": {
    "@statewalker/system.workbench": "workspace:^",
    "@tailwindcss/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:peers"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
