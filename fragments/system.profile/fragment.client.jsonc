// The client aspect of system.profile: the vault view and its activity bar entry on
// system.workbench's points (the `secrets` point comes with statewalker-root#265). Kept equal to
// src/archive.ts by tests/profile.test.ts.
{
  "$schema": "./node_modules/@statewalker/kernel.core/schemas/fragment-aspect.v1.schema.json",
  "extensions": [
    {
      "point": "views",
      "data": {
        "id": "vault",
        "title": "Vault"
      },
      "reference": {
        "module": "./index.js",
        "export": "VaultView"
      }
    },
    {
      "point": "activitybar",
      "data": {
        "id": "vault",
        "title": "Vault",
        "order": 990,
        "view": "system.profile/vault"
      }
    }
  ]
}
