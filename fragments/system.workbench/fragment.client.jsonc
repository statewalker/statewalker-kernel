// The client aspect of system.workbench: the `views` extension point, and the commands that dock
// surfaces. Kept equal to src/archive.ts by tests/views.test.ts.
{
  "$schema": "./node_modules/@statewalker/kernel.core/schemas/fragment-aspect.v1.schema.json",
  "extensionPoints": {
    "views": {
      "description": "Views the workbench shows, each a React component (the lazy reference).",
      "schema": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The view's id within its fragment; its identity is `<fragment-id>/<id>`.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "title": {
            "description": "The title its tab shows.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "extensions": [
    {
      "point": "commands",
      "data": {
        "operation": {
          "operationId": "open-surface",
          "summary": "Pop a surface out into the workbench's dock",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["surfaceId"],
                  "additionalProperties": false,
                  "properties": {
                    "surfaceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Done",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      },
      "reference": {
        "module": "./index.js",
        "export": "openSurface"
      }
    },
    {
      "point": "commands",
      "data": {
        "operation": {
          "operationId": "close-surface",
          "summary": "Take a surface out of the dock",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["surfaceId"],
                  "additionalProperties": false,
                  "properties": {
                    "surfaceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Done",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      },
      "reference": {
        "module": "./index.js",
        "export": "closeSurface"
      }
    }
  ]
}
