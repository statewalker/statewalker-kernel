// The client aspect of system.commands: the `commands` and `keybindings` extension points.
// Kept equal to src/archive.ts by tests/points.test.ts.
{
  "$schema": "./node_modules/@statewalker/kernel.core/schemas/fragment-aspect.v1.schema.json",
  "extensionPoints": {
    "commands": {
      "description": "Commands, each one OpenAPI operation, its handler the lazy reference.",
      "schema": {
        "type": "object",
        "required": ["operation"],
        "additionalProperties": false,
        "if": {
          "required": ["exposures"],
          "properties": {
            "exposures": {
              "required": ["task"]
            }
          }
        },
        "then": {
          "properties": {
            "operation": {
              "required": ["x-idempotent", "responses"],
              "properties": {
                "x-idempotent": {
                  "const": true
                },
                "responses": {
                  "required": ["200"],
                  "properties": {
                    "200": {
                      "required": ["content"],
                      "properties": {
                        "content": {
                          "required": ["application/json"],
                          "properties": {
                            "application/json": {
                              "required": ["schema"],
                              "properties": {
                                "schema": {
                                  "required": ["type"],
                                  "properties": {
                                    "type": {
                                      "const": "object"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "properties": {
          "operation": {
            "description": "The command as an OpenAPI 3.1 operation: operationId is the command id, the JSON request body its input (an object), the 200 JSON response its output, other responses its errors.",
            "type": "object",
            "required": ["operationId"],
            "properties": {
              "operationId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "summary": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "requestBody": {
                "type": "object",
                "required": ["content"],
                "properties": {
                  "content": {
                    "type": "object",
                    "required": ["application/json"],
                    "properties": {
                      "application/json": {
                        "type": "object",
                        "required": ["schema"],
                        "properties": {
                          "schema": {
                            "type": "object",
                            "required": ["type"],
                            "properties": {
                              "type": {
                                "const": "object"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "responses": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^([1-5]([0-9]{2}|XX)|default)$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "object",
                      "properties": {
                        "application/json": {
                          "type": "object",
                          "properties": {
                            "schema": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "exposures": {
            "description": "Where the command is offered besides the bus. Internal when absent.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "agent": {
                "description": "A harness tool, with its action kind.",
                "type": "object",
                "required": ["action"],
                "additionalProperties": false,
                "properties": {
                  "action": {
                    "enum": ["read", "write", "admin"]
                  }
                }
              },
              "http": {
                "description": "A REST endpoint (POST) at `path`, under the fragment's prefix.",
                "type": "object",
                "required": ["path"],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/"
                  }
                }
              },
              "mcp": {
                "description": "An MCP tool. Implies `http`: without one, the command is served at `/commands/<command-id>`.",
                "type": "object",
                "additionalProperties": false
              },
              "task": {
                "description": "Served from the task queue (system.tasks): a task under `fragments.<fragment-id>.<command-id>` runs the command. A task is delivered at least once and its reply is JSON, so the operation must declare `x-idempotent: true` and a JSON object output (its 200 response).",
                "type": "object",
                "additionalProperties": false
              }
            }
          },
          "labels": {
            "description": "Localized title and description, by locale (`fr`, `fr-CA`).",
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "keybindings": {
      "description": "Key chords calling commands.",
      "schema": {
        "type": "object",
        "required": ["key", "command"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "description": "The key chord (`ctrl+shift+p`).",
            "type": "string",
            "minLength": 1
          },
          "command": {
            "description": "The command's identity, `<fragment-id>/<command-id>`.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*/[a-z][a-z0-9-]*$"
          },
          "when": {
            "description": "A context expression, read by the workbench.",
            "type": "string"
          }
        }
      }
    }
  }
}
