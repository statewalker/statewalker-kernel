// The client aspect of notes: a view, two commands, and the chrome that reaches them (a menu bar
// menu, the view's context and tab menus, a keybinding, a status bar item, an activity bar entry),
// plus the dialog and the notification new-note raises, and its texts in English and French on
// system.l10n's `l10n` point (the French bundle leaves `view.count` out on purpose: French shows
// the English text, the default language's), and its settings page on system.settings' `settings`
// point, its labels in both languages too. All static: the workbench shows them before
// client/index.js loads. Its code is client/index.js, built from client/index.tsx with the shared
// modules (react, @statewalker/ui.view.shadcn, @statewalker/client.core) left to the shell's
// import map; its CSS is client/index.css.
{
  "$schema": "../../node_modules/@statewalker/kernel.core/schemas/fragment-aspect.v1.schema.json",
  "extensionPoints": {
    "actions": {
      "description": "Actions on the notes: a button in the notes view each, calling the extension's reference with { notes: [{ text }] } and showing the { message } it answers.",
      "schema": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "description": "The button's label.",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "order": {
            "description": "Buttons are sorted by order (0 by default), then title.",
            "type": "number"
          }
        }
      }
    }
  },
  "extensions": [
    {
      "point": "views",
      "data": {
        "id": "notes",
        "title": "Notes"
      },
      "reference": {
        "module": "./index.js",
        "export": "NotesView"
      }
    },
    {
      "point": "commands",
      "data": {
        "operation": {
          "operationId": "add-note",
          "summary": "Add a note",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["text"],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "The number of notes",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": ["count"],
                    "properties": {
                      "count": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "labels": {
          "fr": {
            "title": "Ajouter une note"
          }
        }
      },
      "reference": {
        "module": "./index.js",
        "export": "addNote"
      }
    },
    {
      "point": "commands",
      "data": {
        "operation": {
          "operationId": "list-notes",
          "summary": "List the notes",
          "responses": {
            "200": {
              "description": "The notes, oldest first",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": ["notes"],
                    "properties": {
                      "notes": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["text"],
                          "properties": {
                            "text": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "labels": {
          "fr": {
            "title": "Lister les notes"
          }
        }
      },
      "reference": {
        "module": "./index.js",
        "export": "listNotes"
      }
    },
    {
      "point": "commands",
      "data": {
        "operation": {
          "operationId": "new-note",
          "summary": "New note…",
          "description": "Ask for a note's text in a dialog, add it, and say so in a notification.",
          "responses": {
            "200": {
              "description": "Whether a note was added",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": ["added"],
                    "properties": {
                      "added": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "labels": {
          "fr": {
            "title": "Nouvelle note…"
          }
        }
      },
      "reference": {
        "module": "./index.js",
        "export": "newNote"
      }
    },
    {
      "point": "menus",
      "data": {
        "menu": "menubar",
        "submenu": "notes",
        "title": "Notes"
      }
    },
    {
      "point": "menus",
      "data": {
        "menu": "notes",
        "command": "org.statewalker.notes/new-note"
      }
    },
    {
      "point": "menus",
      "data": {
        "menu": "view/context",
        "command": "org.statewalker.notes/new-note",
        "when": "view == org.statewalker.notes/notes"
      }
    },
    {
      "point": "menus",
      "data": {
        "menu": "view/title",
        "command": "org.statewalker.notes/new-note",
        "when": "view == org.statewalker.notes/notes"
      }
    },
    {
      "point": "keybindings",
      "data": {
        "key": "ctrl+alt+n",
        "command": "org.statewalker.notes/new-note"
      }
    },
    {
      "point": "dialogs",
      "data": {
        "id": "new-note",
        "title": "New note",
        "message": "What should the note say?",
        "input": {
          "label": "Note",
          "placeholder": "Write a note"
        },
        "actions": [
          {
            "id": "add",
            "label": "Add",
            "primary": true
          },
          {
            "id": "cancel",
            "label": "Cancel"
          }
        ]
      }
    },
    {
      "point": "notifications",
      "data": {
        "id": "note-added",
        "title": "Note added",
        "message": "{text}",
        "severity": "success",
        "actions": [
          {
            "id": "undo",
            "label": "Undo"
          }
        ]
      }
    },
    {
      "point": "statusbar",
      "data": {
        "id": "new-note",
        "text": "New note",
        "tooltip": "Write a new note",
        "command": "org.statewalker.notes/new-note"
      }
    },
    {
      "point": "statusbar",
      "data": {
        "id": "active",
        "text": "Notes view",
        "alignment": "right",
        "tooltip": "The notes view is active",
        "when": "activeView == org.statewalker.notes/notes"
      }
    },
    {
      "point": "activitybar",
      "data": {
        "id": "notes",
        "title": "Notes",
        "view": "org.statewalker.notes/notes"
      }
    },
    {
      "point": "settings",
      "data": {
        "title": "Notes",
        "description": "How the notes view shows your notes.",
        "schema": {
          "type": "object",
          "properties": {
            "sort": {
              "type": "string",
              "title": "Sort notes by",
              "enum": ["added", "alphabetical"],
              "default": "added"
            },
            "copyButtons": {
              "type": "boolean",
              "title": "Show Copy buttons",
              "default": true
            }
          }
        }
      }
    },
    {
      "point": "l10n",
      "data": {
        "locale": "en",
        "messages": {
          "view.count": "Notes: {count}",
          "settings.sort.enum.added": "Order added",
          "settings.sort.enum.alphabetical": "Alphabetical"
        }
      }
    },
    {
      "point": "l10n",
      "data": {
        "locale": "fr",
        "messages": {
          "views.notes.title": "Bloc-notes",
          "menus.notes.title": "Bloc-notes",
          "activitybar.notes.title": "Bloc-notes",
          "view.title": "Bloc-notes",
          "view.field": "Note",
          "view.placeholder": "Écrire une note",
          "view.add": "Ajouter la note",
          "view.copy": "Copier",
          "dialogs.new-note.title": "Nouvelle note",
          "dialogs.new-note.message": "Que doit dire la note ?",
          "dialogs.new-note.input.label": "Note",
          "dialogs.new-note.input.placeholder": "Écrire une note",
          "dialogs.new-note.actions.add": "Ajouter",
          "dialogs.new-note.actions.cancel": "Annuler",
          "notifications.note-added.title": "Note ajoutée",
          "notifications.note-added.actions.undo": "Annuler",
          "statusbar.new-note.text": "Nouvelle note",
          "statusbar.new-note.tooltip": "Écrire une nouvelle note",
          "statusbar.active.text": "Vue des notes",
          "statusbar.active.tooltip": "La vue des notes est active",
          "settings.title": "Bloc-notes",
          "settings.description": "Comment la vue des notes montre vos notes.",
          "settings.sort.title": "Trier les notes par",
          "settings.sort.enum.added": "Ordre d'ajout",
          "settings.sort.enum.alphabetical": "Ordre alphabétique",
          "settings.copyButtons.title": "Afficher les boutons Copier"
        }
      }
    }
  ]
}
