{
  "name": "@statewalker/notes.app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The notes demo of the platform: the kernel with system.commands, system.workbench, system.a2ui, system.appearance and system.host, a client-only notes fragment installed while it runs, and a surfaces demo fragment placing an A2UI surface.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/launch.mjs browser",
    "start:browser": "node scripts/launch.mjs browser",
    "start:node": "node scripts/launch.mjs node",
    "start:wrangler": "node scripts/launch.mjs wrangler",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
