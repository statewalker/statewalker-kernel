    "@statewalker/platform.browser": "workspace:^",
    "@statewalker/system.a2ui": "workspace:^",
    "@statewalker/system.appearance": "workspace:^",
    "@statewalker/system.commands": "workspace:^",
    "@statewalker/system.fragments": "workspace:^",
    "@statewalker/system.host": "workspace:^",
    "@statewalker/system.l10n": "workspace:^",
    "@statewalker/system.profile": "workspace:^",
    "@statewalker/system.settings": "workspace:^",
