{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useFocusableInteractive": "warn",
        "useSemanticElements": "warn",
        "noLabelWithoutControl": "warn",
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn",
        "useAriaPropsForRole": "warn",
        "useValidAnchor": "warn",
        "useKeyWithClickEvents": "warn"
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentWidth": 2
    }
  },
  "files": {
    "includes": ["**", "!**/*.css"]
  },
  "overrides": [
    {
      "includes": ["packages/**", "fragments/*/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "packages/ and a fragment's src/ hold UI-free, isomorphic code: React belongs in packages-react/ or a fragment's client/ (statewalker-root ADR 2026-11-19-platform-project-and-fragment-repositories).",
                  "react-dom": "packages/ and a fragment's src/ hold UI-free, isomorphic code: React belongs in packages-react/ or a fragment's client/ (statewalker-root ADR 2026-11-19-platform-project-and-fragment-repositories)."
                },
                "patterns": [
                  {
                    "group": ["react/**", "react-dom/**"],
                    "message": "packages/ and a fragment's src/ hold UI-free, isomorphic code: React belongs in packages-react/ or a fragment's client/ (statewalker-root ADR 2026-11-19-platform-project-and-fragment-repositories)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
